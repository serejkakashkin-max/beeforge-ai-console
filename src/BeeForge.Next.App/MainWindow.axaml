<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BeeForge.Next.App.MainWindow"
        Width="1280" Height="820" MinWidth="980" MinHeight="640"
        Title="BeeForge AI Console Next — preview"
        Background="#111B28" Foreground="#EAF2F7">
  <Grid RowDefinitions="76,*" Margin="0">
    <Border Grid.Row="0" Background="#152437" BorderBrush="#2D4658" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" Margin="28,0">
        <StackPanel VerticalAlignment="Center" Spacing="3">
          <TextBlock Text="BEEFORGE / NEXT" FontSize="22" FontWeight="Bold" Foreground="#EAF2F7" />
          <TextBlock Text="Единая консоль модели и AI-команды · предварительная оболочка" FontSize="12" Foreground="#A6B9C6" />
        </StackPanel>
        <Border Grid.Column="1" Background="#203E48" CornerRadius="12" Padding="13,7" VerticalAlignment="Center">
          <TextBlock Text="BEEFORGE BACKEND · SAFE ADAPTER" Foreground="#9EE0D0" FontSize="11" FontWeight="SemiBold" />
        </Border>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" TabStripPlacement="Left" Background="#111B28" BorderThickness="0">
      <TabItem Header="Обзор">
        <ScrollViewer>
          <StackPanel Margin="34,27" Spacing="22">
            <StackPanel Spacing="6">
              <TextBlock Text="Рабочее пространство" FontSize="30" FontWeight="SemiBold" />
              <TextBlock Text="Профили и состояние берутся из существующего BeeForge. Управление моделью использует его проверенный backend." Foreground="#A6B9C6" />
            </StackPanel>
            <Border Background="#1B2B3C" BorderBrush="#365162" BorderThickness="1" CornerRadius="12" Padding="22">
              <StackPanel Spacing="14">
                <TextBlock Text="АКТИВНЫЙ ПРОФИЛЬ" FontSize="11" FontWeight="Bold" Foreground="#82BFC3" />
                <TextBlock Text="{Binding ActiveProfile}" FontSize="24" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="26">
                  <StackPanel Spacing="4"><TextBlock Text="Подключение" Foreground="#A6B9C6" /><TextBlock Text="{Binding Mode}" FontWeight="SemiBold" /></StackPanel>
                  <StackPanel Spacing="4"><TextBlock Text="Сохранено профилей" Foreground="#A6B9C6" /><TextBlock Text="{Binding ProfileCount}" FontWeight="SemiBold" /></StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Background="#163B39" BorderBrush="#29736A" BorderThickness="1" CornerRadius="8" Padding="14">
              <TextBlock Text="{Binding Status}" Foreground="#B9EBD9" />
            </Border>
            <TextBlock Text="{Binding RuntimeStatusText}" TextWrapping="Wrap" Foreground="#A6B9C6" />
            <TextBlock Text="{Binding RuntimeDetailsText}" TextWrapping="Wrap" Foreground="#A6B9C6" />
            <TextBlock Text="Team Guard, Telegram, Serena и системные действия используют совместимый BeeForge backend; отдельное старое окно для запуска модели не требуется." TextWrapping="Wrap" Foreground="#A6B9C6" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Модели">
        <ScrollViewer><StackPanel Margin="34,27" Spacing="16">
          <TextBlock Text="Профили модели" FontSize="28" FontWeight="SemiBold" />
          <TextBlock Text="Локальные и удалённые профили. Изменения сохраняются с резервной копией и применяются при следующем запуске модели." TextWrapping="Wrap" Foreground="#A6B9C6" />
          <ListBox ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" Background="#1B2B3C" BorderBrush="#365162" MinHeight="200" />
          <WrapPanel>
            <Button Content="Новый" Click="NewProfile_Click" Margin="0,0,8,8" />
            <Button Content="Редактировать" Click="EditProfile_Click" Margin="0,0,8,8" />
            <Button Content="Клонировать" Click="CloneProfile_Click" Margin="0,0,8,8" />
            <Button Content="Импорт" Click="ImportProfile_Click" Margin="0,0,8,8" />
            <Button Content="Экспорт" Click="ExportProfile_Click" Margin="0,0,8,8" />
            <Button Content="Удалить" Click="DeleteProfile_Click" Margin="0,0,8,8" />
            <Button Content="Обновить" Click="RefreshProfiles_Click" Margin="0,0,8,8" />
          </WrapPanel>
          <TextBlock Text="{Binding ProfileMessage}" TextWrapping="Wrap" Foreground="#B9EBD9" />
          <TextBlock Text="HUGGING FACE · GGUF" Foreground="#82BFC3" FontSize="11" FontWeight="Bold" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Text="{Binding HfQuery, Mode=TwoWay}" Width="360" PlaceholderText="Поиск модели" />
            <Button Content="Найти" Click="HfSearch_Click" IsEnabled="{Binding CanUseHf}" />
            <Button Content="Файлы выбранного" Click="HfFiles_Click" IsEnabled="{Binding CanUseHf}" />
            <Button Content="Скачать GGUF" Click="HfDownload_Click" IsEnabled="{Binding CanUseHf}" />
          </StackPanel>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <ListBox Grid.Column="0" ItemsSource="{Binding HfRepos}" SelectedItem="{Binding SelectedHfRepo, Mode=TwoWay}" MinHeight="150" MaxHeight="220" Background="#1B2B3C" />
            <ListBox Grid.Column="1" ItemsSource="{Binding HfFiles}" SelectedItem="{Binding SelectedHfFile, Mode=TwoWay}" MinHeight="150" MaxHeight="220" Background="#1B2B3C" />
          </Grid>
          <TextBlock Text="{Binding HfStatus}" TextWrapping="Wrap" Foreground="#B9EBD9" />
          <TextBlock Text="СЦЕНАРИИ · БЕЗ АВТОЗАПУСКА" Foreground="#82BFC3" FontSize="11" FontWeight="Bold" />
          <ListBox ItemsSource="{Binding Scenarios}" SelectedItem="{Binding SelectedScenario, Mode=TwoWay}" MinHeight="90" MaxHeight="150" Background="#1B2B3C" />
          <WrapPanel>
            <Button Content="Новый сценарий" Click="NewScenario_Click" Margin="0,0,8,8" />
            <Button Content="Выбрать первый профиль" Click="SelectScenarioProfile_Click" Margin="0,0,8,8" />
            <Button Content="Удалить сценарий" Click="DeleteScenario_Click" Margin="0,0,8,8" />
          </WrapPanel>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Inference">
        <StackPanel Margin="34,27" Spacing="14">
          <TextBlock Text="Inference" FontSize="28" FontWeight="SemiBold" />
          <TextBlock Text="BeeForge Next запускает модель через проверенный runtime-backend: он проверяет профиль, владение процессом и готовность сервера. Старое окно BeeForge запускать не требуется." TextWrapping="Wrap" Foreground="#A6B9C6" />
          <StackPanel Orientation="Horizontal" Spacing="9">
            <Button Content="Проверить состояние" Click="RefreshRuntime_Click" IsEnabled="{Binding CanRefreshRuntime}" Background="#294455" Foreground="#EAF2F7" Padding="14,9" />
            <Button Content="Запустить выбранный" Click="StartRuntime_Click" IsEnabled="{Binding CanControlLocal}" Background="#176E68" Foreground="White" Padding="14,9" />
            <Button Content="Остановить модель" Click="StopRuntime_Click" IsEnabled="{Binding CanControlLocal}" Background="#6E3939" Foreground="White" Padding="14,9" />
            <Button Content="Подключить удалённый профиль" Click="ConnectRemote_Click" IsEnabled="{Binding CanConnectRemote}" Background="#315B84" Foreground="White" Padding="14,9" />
          </StackPanel>
          <Border Background="#1B2B3C" BorderBrush="#365162" BorderThickness="1" CornerRadius="8" Padding="13">
            <TextBlock Text="{Binding RuntimeStatusText}" TextWrapping="Wrap" Foreground="#B9EBD9" />
          </Border>
          <TextBlock Text="{Binding RuntimeDetailsText}" TextWrapping="Wrap" Foreground="#A6B9C6" />
          <TextBlock Text="ПЛАН ЗАПУСКА · ТОЛЬКО ЧТЕНИЕ" Foreground="#82BFC3" FontSize="11" FontWeight="Bold" />
          <TextBox Text="{Binding CommandPreview, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12" MinHeight="420" Background="#1B2B3C" Foreground="#EAF2F7" BorderBrush="#365162" />
          <TextBlock Text="Настройки профиля доступны в разделе «Модели»." TextWrapping="Wrap" Foreground="#A6B9C6" />
        </StackPanel>
      </TabItem>
      <TabItem Header="Оптимизация">
        <ScrollViewer>
        <StackPanel Margin="34,27" Spacing="14">
          <TextBlock Text="Оптимизация" FontSize="28" FontWeight="SemiBold" />
          <TextBlock Text="GGUF и сравнимый бенчмарк: первый прогон — разогрев, затем повторные замеры и история по профилю. Автоподбор параметров запуска выполняется отдельно и не меняет работающую модель без вашего решения." TextWrapping="Wrap" Foreground="#A6B9C6" />
          <TextBox Text="{Binding ModelMetadataText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" MinHeight="240" Background="#1B2B3C" Foreground="#EAF2F7" BorderBrush="#365162" />
          <TextBlock Text="ПОВТОРЯЕМЫЙ ТЕСТ СКОРОСТИ · HTTP /completion" Foreground="#82BFC3" FontSize="11" FontWeight="Bold" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Быстрый 512/128" Click="PresetShort_Click" Padding="10,5" />
            <Button Content="Обычный 4096/256" Click="PresetStandard_Click" Padding="10,5" />
            <Button Content="Длинный 32768/256" Click="PresetLong_Click" Padding="10,5" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <StackPanel Spacing="4"><TextBlock Text="Input tokens" Foreground="#A6B9C6" /><TextBox Text="{Binding BenchmarkInputText, Mode=TwoWay}" Width="110" /></StackPanel>
            <StackPanel Spacing="4"><TextBlock Text="Output tokens" Foreground="#A6B9C6" /><TextBox Text="{Binding BenchmarkOutputText, Mode=TwoWay}" Width="110" /></StackPanel>
            <StackPanel Spacing="4"><TextBlock Text="Timeout, сек" Foreground="#A6B9C6" /><TextBox Text="{Binding BenchmarkTimeoutText, Mode=TwoWay}" Width="110" /></StackPanel>
            <StackPanel Spacing="4"><TextBlock Text="Повторы" Foreground="#A6B9C6" /><TextBox Text="{Binding BenchmarkRepeatsText, Mode=TwoWay}" Width="80" /></StackPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="9">
            <Button Content="Запустить тест" Click="StartBenchmark_Click" IsEnabled="{Binding CanRunBenchmark}" Background="#176E68" Foreground="White" Padding="14,9" />
            <Button Content="Обновить историю" Click="RefreshBenchmark_Click" IsEnabled="{Binding CanRefreshBenchmark}" Background="#294455" Foreground="#EAF2F7" Padding="14,9" />
            <Button Content="Стоп тест" Click="StopBenchmark_Click" IsEnabled="{Binding CanStopBenchmark}" Background="#6E3939" Foreground="White" Padding="14,9" />
          </StackPanel>
          <TextBlock Text="{Binding BenchmarkStatusText}" TextWrapping="Wrap" Foreground="#B9EBD9" />
          <TextBlock Text="ИСТОРИЯ ПРОГОНОВ ВСЕХ ПРОФИЛЕЙ" Foreground="#82BFC3" FontSize="11" FontWeight="Bold" />
          <TextBox Text="{Binding BenchmarkHistoryText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" MinHeight="150" Background="#1B2B3C" Foreground="#EAF2F7" BorderBrush="#365162" />
          <TextBlock Text="Выберите один или несколько прогонов для отчёта:" Foreground="#A6B9C6" />
          <ListBox Name="BenchmarkRunsList" ItemsSource="{Binding BenchmarkRunOptions}" SelectionMode="Multiple" MinHeight="110" MaxHeight="180" Background="#1B2B3C" />
          <Button Content="Сохранить сравнение Markdown" Click="ExportBenchmark_Click" Background="#294455" Foreground="#EAF2F7" Padding="14,9" HorizontalAlignment="Left" />
          <TextBlock Text="АВТОПОДБОР ПАРАМЕТРОВ" Foreground="#82BFC3" FontSize="11" FontWeight="Bold" />
          <TextBlock Text="После остановки локальной модели: исходный профиль → контрольные варианты → 12 шагов адаптивного TPE-поиска из LlamaServerLauncher → повторная проверка. Подбираются batch, ubatch, потоки, Flash Attention и доступные варианты GPU/CPU MoE. Дубли не запускаются повторно. KV-качество и рабочий профиль не меняются." TextWrapping="Wrap" Foreground="#A6B9C6" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Цель:" VerticalAlignment="Center" Foreground="#A6B9C6" />
            <ComboBox ItemsSource="{Binding OptimizationObjectives}" SelectedItem="{Binding SelectedOptimizationObjective, Mode=TwoWay}" Width="185" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="9">
            <Button Content="Подобрать настройки" Click="AutoTune_Click" IsEnabled="{Binding CanAutoTune}" Background="#176E68" Foreground="White" Padding="14,9" />
            <Button Content="Сохранить как новый профиль" Click="SaveAutoTune_Click" IsEnabled="{Binding CanSaveTune}" Background="#294455" Foreground="#EAF2F7" Padding="14,9" />
          </StackPanel>
        </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="AI Workspace">
        <StackPanel Margin="34,27" Spacing="14">
          <TextBlock Text="AI Workspace" FontSize="28" FontWeight="SemiBold" />
          <TextBlock Text="Team Lead, специалисты, skills, MCP, Team Guard и Serena работают через существующий BeeForge. Этот экран показывает только безопасный обзор OpenCode; prompts и разрешения не меняются." TextWrapping="Wrap" Foreground="#A6B9C6" />
          <Button Content="Обновить команду" Click="RefreshTeam_Click" HorizontalAlignment="Left" Background="#294455" Foreground="#EAF2F7" Padding="14,9" />
          <TextBox Text="{Binding TeamText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" MinHeight="420" Background="#1B2B3C" Foreground="#EAF2F7" BorderBrush="#365162" />
        </StackPanel>
      </TabItem>
      <TabItem Header="Удалённый доступ">
        <StackPanel Margin="34,27" Spacing="14">
          <TextBlock Text="Удалённый доступ" FontSize="28" FontWeight="SemiBold" />
          <TextBlock Text="Действия используют существующий backend BeeForge. Удалённый доступ передаёт модель ноутбуку и блокирует локальные запросы; файлы проектов остаются на каждом устройстве." TextWrapping="Wrap" Foreground="#A6B9C6" />
          <WrapPanel IsEnabled="{Binding CanUseServices}">
            <Button Content="Состояние Tailscale" Tag="RemoteStatus" Click="Service_Click" Margin="0,0,8,8" />
            <Button Content="Включить доступ" Tag="RemoteEnable" Click="Service_Click" Margin="0,0,8,8" />
            <Button Content="Выключить доступ" Tag="RemoteDisable" Click="Service_Click" Margin="0,0,8,8" />
            <Button Content="Команда для ноутбука" Tag="RemoteInstallCommand" Click="Service_Click" Margin="0,0,8,8" />
          </WrapPanel>
          <TextBlock Text="TELEGRAM" Foreground="#82BFC3" FontSize="11" FontWeight="Bold" />
          <WrapPanel IsEnabled="{Binding CanUseServices}">
            <Button Content="Состояние бота" Tag="TelegramStatus" Click="Service_Click" Margin="0,0,8,8" />
            <Button Content="Запустить бота" Tag="TelegramStart" Click="Service_Click" Margin="0,0,8,8" />
            <Button Content="Остановить бота" Tag="TelegramStop" Click="Service_Click" Margin="0,0,8,8" />
          </WrapPanel>
          <TextBlock Text="ПРАВА И ПАМЯТЬ КОМАНДЫ" Foreground="#82BFC3" FontSize="11" FontWeight="Bold" />
          <WrapPanel IsEnabled="{Binding CanUseServices}">
            <Button Content="Состояние прав" Tag="FullAccessStatus" Click="Service_Click" Margin="0,0,8,8" />
            <Button Content="Полный доступ" Tag="FullAccessEnable" Click="Service_Click" Margin="0,0,8,8" />
            <Button Content="Выключить полный доступ" Tag="FullAccessDisable" Click="Service_Click" Margin="0,0,8,8" />
            <Button Content="Память проектов Serena" Tag="SerenaProjects" Click="Service_Click" Margin="0,0,8,8" />
          </WrapPanel>
          <TextBox Text="{Binding ServiceText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" MinHeight="300" />
        </StackPanel>
      </TabItem>
      <TabItem Header="Система">
        <StackPanel Margin="34,27" Spacing="14">
          <TextBlock Text="Система" FontSize="28" FontWeight="SemiBold" />
          <TextBlock Text="RUNTIME" Foreground="#82BFC3" FontSize="11" FontWeight="Bold" />
          <WrapPanel>
            <Button Content="Обновить список runtime" Click="RefreshRuntimeCatalog_Click" Margin="0,0,8,8" />
            <Button Content="Установить BeeLlama v0.4.6" Click="InstallRuntime_Click" Margin="0,0,8,8" />
            <Button Content="llama.cpp CUDA" Tag="Cuda" Click="InstallUpstreamRuntime_Click" Margin="0,0,8,8" />
            <Button Content="llama.cpp Vulkan" Tag="Vulkan" Click="InstallUpstreamRuntime_Click" Margin="0,0,8,8" />
            <Button Content="llama.cpp HIP" Tag="Hip" Click="InstallUpstreamRuntime_Click" Margin="0,0,8,8" />
            <Button Content="llama.cpp SYCL" Tag="Sycl" Click="InstallUpstreamRuntime_Click" Margin="0,0,8,8" />
            <Button Content="llama.cpp CPU" Tag="Cpu" Click="InstallUpstreamRuntime_Click" Margin="0,0,8,8" />
          </WrapPanel>
          <TextBox Text="{Binding RuntimeCatalogText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" MinHeight="120" Background="#1B2B3C" Foreground="#EAF2F7" BorderBrush="#365162" />
          <TextBlock Text="ON-DEMAND OPENAI PROXY" Foreground="#82BFC3" FontSize="11" FontWeight="Bold" />
          <TextBlock Text="Локальный маршрутизатор профилей: model = alias/имя профиля. Слушает только 127.0.0.1:18080 и использует существующий BeeForge для запуска/остановки модели." TextWrapping="Wrap" Foreground="#A6B9C6" />
          <Button Content="Включить / выключить proxy" Click="ToggleProxy_Click" HorizontalAlignment="Left" Margin="0,0,0,4" />
          <TextBlock Text="{Binding ProxyText}" TextWrapping="Wrap" Foreground="#B9EBD9" />
          <TextBlock Text="ЛОКАЛЬНАЯ СПРАВКА" Foreground="#82BFC3" FontSize="11" FontWeight="Bold" />
          <WrapPanel>
            <Button Content="Общее" Tag="main" Click="Help_Click" Margin="0,0,8,8" />
            <Button Content="Модель и runtime" Tag="runtime" Click="Help_Click" Margin="0,0,8,8" />
            <Button Content="AI-команда" Tag="team" Click="Help_Click" Margin="0,0,8,8" />
            <Button Content="MCP" Tag="mcp" Click="Help_Click" Margin="0,0,8,8" />
            <Button Content="Архитектура Next" Tag="migration" Click="Help_Click" Margin="0,0,8,8" />
          </WrapPanel>
          <TextBox Text="{Binding HelpText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" MinHeight="220" MaxHeight="360" Background="#1B2B3C" Foreground="#EAF2F7" BorderBrush="#365162" />
          <TextBlock Text="Основной запуск по-прежнему BEEFORGE-AI.cmd. Журналы читаются ограниченным фрагментом и не изменяются." TextWrapping="Wrap" Foreground="#A6B9C6" />
          <StackPanel Orientation="Horizontal" Spacing="9">
            <Button Content="Ошибки модели" Click="ServerLog_Click" Background="#294455" Foreground="#EAF2F7" Padding="14,9" />
            <Button Content="Вывод модели" Click="ServerOutputLog_Click" Background="#294455" Foreground="#EAF2F7" Padding="14,9" />
            <Button Content="Telegram" Click="TelegramLog_Click" Background="#294455" Foreground="#EAF2F7" Padding="14,9" />
          </StackPanel>
          <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12" MinHeight="420" Background="#1B2B3C" Foreground="#EAF2F7" BorderBrush="#365162" />
        </StackPanel>
      </TabItem>
    </TabControl>
  </Grid>
</Window>

